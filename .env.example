# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
FLASK_ENV=development
DATABASE_URL=postgresql://usuario:clave@localhost:5432/repuestos
# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRA_MINUTOS=120
COOKIE_SEGURA=false        # true cuando se sirva por HTTPS (producción)
IVA=0.19
DIR_FACTURAS=facturas
# Lista blanca CORS separada por comas (vacío = solo el mismo origen). No se admite '*'.
CORS_ORIGENES=
LIMITE_LOGIN_POR_MINUTO=10
LIMITE_REGISTRO_POR_HORA=10
